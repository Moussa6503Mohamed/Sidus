# T-0023 local-only HTTPS Core test environment (docker-compose.local-import.yml).
# Copy to .env.local-import (gitignored) and fill in real values. Never commit real values here.
# See docs/local-import-test-environment.md.

# Use the SAME Clerk dev application as apps/web/.env.local, so a session token minted by
# signing in through the web app verifies against this Core instance too.
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_JWT_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Directory containing the private dev TLS cert/key generated per
# docs/local-import-test-environment.md. Never point this at a directory inside this repo.
# Forward slashes, even on Windows (Docker Desktop bind-mount syntax).
SIDUS_LOCAL_TLS_DIR=D:/Sidus-private-content/local-dev
